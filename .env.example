# Base PostgreSQL (docker compose ou Postgres local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solink_daas?schema=public"
# Secret de session (32 caractères minimum)
SESSION_SECRET="change-me-demo-secret-change-me-demo-secret-0123456789"
# Mode démo : sélecteur de compte, OTP 000000, pages /demo
DEMO_MODE="true"
# Répertoire de stockage local des fichiers
STORAGE_DIR="./storage"
# Clé de l'API Financeur de démo
PARTNER_API_KEY="partner_demo_key"
# Secret HMAC des webhooks sortants
WEBHOOK_SECRET="whsec_demo_secret"
# URL publique de l'application
APP_URL="http://localhost:3000"
